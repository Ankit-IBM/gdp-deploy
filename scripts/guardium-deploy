#!/usr/bin/env bash
# IBM Guardium Deployment Automation — enhanced multi-cloud + full lifecycle
# Usage: ./scripts/guardium-deploy <command> [args...]
set -uo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG_FILE="${GUARDIUM_CONFIG:-$PROJECT_ROOT/config/lab.yml}"
STATE_FILE="$PROJECT_ROOT/state/deployment.yml"
LOG_DIR="$PROJECT_ROOT/logs"
DEPLOY_LOG="$LOG_DIR/deployment.log"

mkdir -p "$LOG_DIR" "$PROJECT_ROOT/state"
touch "$DEPLOY_LOG"

log()   { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" | tee -a "$DEPLOY_LOG"; }
error() { log "ERROR: $*"; return 1; }

require_command() {
  command -v "$1" >/dev/null 2>&1 || error "Required command not installed: $1"
}

config_value() {
  python3 - "$CONFIG_FILE" "$1" <<'PY'
import sys
try:    import yaml
except ImportError: raise SystemExit("PyYAML required; activate venv")
with open(sys.argv[1], encoding="utf-8") as f:
    v = yaml.safe_load(f) or {}
for p in sys.argv[2].split('.'):
    if not isinstance(v, dict) or p not in v: v = ''; break
    v = v[p]
print('' if v is None else v)
PY
}

state_set() {
  python3 - "$STATE_FILE" "$1" "$2" <<'PY'
import sys, yaml
path, key, raw = sys.argv[1:]
with open(path, encoding='utf-8') as f: data = yaml.safe_load(f) or {}
value = raw.lower() == 'true' if raw.lower() in {'true','false'} else raw
cur = data
parts = key.split('.')
for p in parts[:-1]: cur = cur.setdefault(p, {})
cur[parts[-1]] = value
with open(path, 'w', encoding='utf-8') as f: yaml.safe_dump(data, f, sort_keys=False)
PY
}

state_get() {
  python3 - "$STATE_FILE" "$1" <<'PY'
import sys, yaml
path, key = sys.argv[1:]
with open(path, encoding='utf-8') as f: data = yaml.safe_load(f) or {}
cur = data
for p in key.split('.'):
    if not isinstance(cur, dict) or p not in cur: cur = ''; break
    cur = cur[p]
print('' if cur is None else cur)
PY
}

# ── venv helper ──────────────────────────────────────────────────────────────
venv_python() {
  local venv="$PROJECT_ROOT/.venv"
  if [[ -x "$venv/bin/python3" ]]; then printf '%s/bin/python3\n' "$venv"; else printf 'python3\n'; fi
}

# ── ISO / bridge / terraform validation ──────────────────────────────────────
select_iso() {
  local configured; configured="$(config_value guardium.iso_path)"
  if [[ -n "$configured" ]]; then
    [[ -f "$configured" ]] || { error "ISO not found: $configured"; return 1; }
    printf '%s\n' "$configured"; return 0
  fi
  mapfile -t images < <(find /home/dev -maxdepth 1 -type f \( -iname '*.iso' -o -iname '*.img' \) | sort)
  case "${#images[@]}" in
    0) error "No Guardium ISO found under /home/dev"; return 1 ;;
    1) printf '%s\n' "${images[0]}"; return 0 ;;
  esac
  [[ -t 0 ]] || { error "Set guardium.iso_path when running non-interactively"; return 1; }
  local i=1; for img in "${images[@]}"; do printf '  %d. %s\n' "$i" "$img" >&2; ((i++)); done
  read -r -p 'Select image number: ' sel
  printf '%s\n' "${images[$((sel-1))]}"
}

validate_host() {
  require_command virsh  || return 1
  require_command ip     || return 1
  require_command ovs-vsctl || return 1
  sudo -n virsh version >/dev/null 2>&1 || { error "libvirt not reachable (requires passwordless sudo)"; return 1; }
  local bridge; bridge="$(config_value network.ovs_bridge)"
  [[ -n "$bridge" ]] || { error "network.ovs_bridge not set in $CONFIG_FILE"; return 1; }
  sudo -n ovs-vsctl br-exists "$bridge" 2>/dev/null || { error "OVS bridge '$bridge' does not exist"; return 1; }
  log "Validated OVS bridge: $bridge"
}

update_deploy_flags() {
  local role="$1"
  local flags="$PROJECT_ROOT/terraform/deploy-flags.auto.tfvars.json"
  python3 - "$flags" "$role" <<'PY'
import json, os, sys
path, role = sys.argv[1:]
flags = {"deploy_collector": False, "deploy_aggregator": False}
if os.path.exists(path):
    with open(path) as f: flags.update(json.load(f))
if role in ("collector","full"): flags["deploy_collector"]  = True
if role in ("aggregator","full"): flags["deploy_aggregator"] = True
with open(path,"w") as f: json.dump(flags, f, indent=2); f.write("\n")
PY
}

terraform_apply() {
  local role="$1" iso="$2"
  local iac; iac="$(command -v terraform || command -v tofu || true)"
  [[ -n "$iac" ]] || { error "Install Terraform or OpenTofu before provisioning"; return 1; }
  local bridge pool; bridge="$(config_value network.ovs_bridge)"; pool="$(config_value kvm.storage_pool)"
  update_deploy_flags "$role"
  sudo -n "$iac" -chdir="$PROJECT_ROOT/terraform" init -upgrade -input=false
  sudo -n "$iac" -chdir="$PROJECT_ROOT/terraform" validate
  local args=(
    -auto-approve -input=false
    -var "iso_path=$iso"
    -var "network_bridge=$bridge"
    -var "storage_pool=$pool"
    -var "cloud_provider=$(config_value cloud.provider 2>/dev/null || echo kvm)"
    -var "collector_name=$(config_value collector.hostname)"
    -var "collector_hostname=$(config_value collector.hostname)"
    -var "collector_ip=$(config_value collector.ip)"
    -var "collector_cpu=$(config_value collector.cpu)"
    -var "collector_memory_mb=$(( $(config_value collector.memory_gb) * 1024 ))"
    -var "collector_disk_gb=$(config_value collector.disk_gb)"
    -var "aggregator_name=$(config_value aggregator.hostname)"
    -var "aggregator_hostname=$(config_value aggregator.hostname)"
    -var "aggregator_ip=$(config_value aggregator.ip)"
    -var "aggregator_cpu=$(config_value aggregator.cpu)"
    -var "aggregator_memory_mb=$(( $(config_value aggregator.memory_gb) * 1024 ))"
    -var "aggregator_disk_gb=$(config_value aggregator.disk_gb)"
  )
  sudo -n "$iac" -chdir="$PROJECT_ROOT/terraform" apply "${args[@]}"
}

select_boot_entry() {
  local role="$1" name downs=0
  name="$(config_value "$role.hostname")"
  [[ "$role" == aggregator ]] && downs=2
  local waited=0
  while [[ "$(sudo -n virsh domstate "$name" 2>/dev/null)" != "running" ]]; do
    sleep 1; ((waited++)); [[ $waited -ge 30 ]] && { error "Timed out waiting for $name"; return 1; }
  done
  sleep 4
  for ((i=0;i<downs;i++)); do sudo -n virsh send-key "$name" --codeset linux --holdtime 150 108; sleep 1; done
  sudo -n virsh send-key "$name" --codeset linux --holdtime 200 28
  sleep 3
  sudo -n virsh screenshot "$name" "$LOG_DIR/${role}-install-start.png" --screen 0 >/dev/null 2>&1 || true
  log "Boot entry selected for $role (Down x$downs, Enter)"
}

maybe_select_boot_entry() {
  local role="$1"
  [[ "$(state_get "$role.install_started")" == True ]] && return 0
  select_boot_entry "$role" || return 1
  state_set "$role.install_started" true
}

provision() {
  local role="$1" iso
  validate_host || return 1
  iso="$(select_iso)"  || return 1
  log "Using ISO: $iso"
  terraform_apply "$role" "$iso" || return 1
  [[ "$role" == collector || "$role" == full ]] && state_set collector.vm_created true
  [[ "$role" == aggregator || "$role" == full ]] && state_set aggregator.vm_created true
  case "$role" in
    collector)  maybe_select_boot_entry collector  ;;
    aggregator) maybe_select_boot_entry aggregator ;;
    full)       maybe_select_boot_entry collector && maybe_select_boot_entry aggregator ;;
  esac
  log "Infrastructure done. Run 'converge <role>' once network is up."
}

converge() {
  local role="$1" ip timeout
  [[ "$role" == collector || "$role" == aggregator ]] || { error "converge: invalid role '$role'"; return 1; }
  require_command ansible-playbook || return 1
  ip="$(config_value "$role.ip")"
  [[ -n "$ip" ]] || { error "$role.ip not set in $CONFIG_FILE"; return 1; }
  timeout="$(config_value guardium.install_timeout_minutes)"; timeout="${timeout:-30}"
  log "Converging $role ($ip)…"
  ansible-playbook -i "${ip}," "$PROJECT_ROOT/ansible/playbooks/wait-for-guardium.yml" \
    --extra-vars "ansible_host=$ip role=$role converge_timeout_seconds=$((timeout*60))" || return 1
  state_set "$role.install_complete" true
  log "$role converge complete"
}

# ── Registration ──────────────────────────────────────────────────────────────
register() {
  log "Registering Collector → Aggregator"
  require_command ansible-playbook || return 1

  local col_ip agg_ip col_url
  col_ip="$(config_value collector.ip)"
  agg_ip="$(config_value aggregator.ip)"
  col_url="https://${col_ip}:8443"

  # Credentials from environment (never hard-coded)
  local col_user="${GUARDIUM_COLLECTOR_USERNAME:-admin}"
  local col_pass="${GUARDIUM_COLLECTOR_PASSWORD:-}"
  local agg_user="${GUARDIUM_AGGREGATOR_USERNAME:-admin}"
  local agg_pass="${GUARDIUM_AGGREGATOR_PASSWORD:-}"

  if [[ -z "$col_pass" || -z "$agg_pass" ]]; then
    if [[ -t 0 ]]; then
      read -r -p "Collector admin username [$col_user]: " in_cu; [[ -n "$in_cu" ]] && col_user="$in_cu"
      read -rs -p "Collector admin password: " col_pass; echo
      read -r -p "Aggregator admin username [$agg_user]: " in_au; [[ -n "$in_au" ]] && agg_user="$in_au"
      read -rs -p "Aggregator admin password: " agg_pass; echo
    else
      error "Set GUARDIUM_COLLECTOR_PASSWORD and GUARDIUM_AGGREGATOR_PASSWORD env vars for non-interactive use"
      return 1
    fi
  fi

  ansible-playbook "$PROJECT_ROOT/ansible/playbooks/register-collector.yml" \
    --extra-vars "collector_url=$col_url" \
    --extra-vars "collector_username=$col_user" \
    --extra-vars "collector_password=$col_pass" \
    --extra-vars "aggregator_ip=$agg_ip" \
    --extra-vars "aggregator_username=$agg_user" \
    --extra-vars "aggregator_password=$agg_pass" || return 1

  state_set registration.collector_registered true
  log "Collector registered to Aggregator"
}

# ── Policy deployment ─────────────────────────────────────────────────────────
policies() {
  log "Deploying sample security policies to Collector"
  require_command ansible-playbook || return 1

  local col_ip col_url col_user col_pass
  col_ip="$(config_value collector.ip)"
  col_url="https://${col_ip}:8443"
  col_user="${GUARDIUM_COLLECTOR_USERNAME:-admin}"
  col_pass="${GUARDIUM_COLLECTOR_PASSWORD:-}"

  if [[ -z "$col_pass" && -t 0 ]]; then
    read -r -p "Collector admin username [$col_user]: " in; [[ -n "$in" ]] && col_user="$in"
    read -rs -p "Collector admin password: " col_pass; echo
  elif [[ -z "$col_pass" ]]; then
    error "Set GUARDIUM_COLLECTOR_PASSWORD for non-interactive policy deployment"; return 1
  fi

  ansible-playbook "$PROJECT_ROOT/ansible/playbooks/deploy-policies.yml" \
    --extra-vars "collector_url=$col_url" \
    --extra-vars "collector_username=$col_user" \
    --extra-vars "collector_password=$col_pass" || return 1

  state_set policies.deployed true
  log "Sample policies deployed"
}

# ── S-TAP / GIM installation ──────────────────────────────────────────────────
install_stap() {
  local col_ip; col_ip="$(config_value collector.ip)"

  # Prompt user for method and confirmation
  echo ""
  echo "S-TAP Installation"
  echo "────────────────────────────────────────────────────────────────────"
  echo "  1. SSH   — Linux/Unix DB server (automated via Ansible)"
  echo "  2. WinRM — Windows DB server    (automated via Ansible)"
  echo "  3. GIM   — Guardium Installation Manager (IBM enterprise method)"
  echo "  4. Manual — Print one-liner commands only (no automation)"
  echo ""

  local method
  if [[ -t 0 ]]; then
    read -r -p "Select S-TAP installation method [1/2/3/4]: " method
  else
    method="${STAP_METHOD:-1}"
  fi

  case "$method" in
    1|ssh)
      echo ""
      read -r -p "Proceed with automated SSH S-TAP install? [Y/n]: " confirm
      if [[ "${confirm,,}" == "n" || "${confirm,,}" == "no" ]]; then
        log "Automated install declined. Printing manual SSH one-liner commands..."
        "$(venv_python)" -m guardapi.stap manual \
          --method ssh \
          --host "<DB_SERVER_IP>" \
          --guardium-ip "$col_ip"
        return 0
      fi
      ansible-playbook -i "$PROJECT_ROOT/ansible/inventory/hosts.yml" \
        "$PROJECT_ROOT/ansible/playbooks/install-stap-ssh.yml" \
        --extra-vars "guardium_collector_ip=$col_ip" || return 1
      state_set agents.stap true
      ;;

    2|winrm)
      echo ""
      read -r -p "Proceed with automated WinRM S-TAP install? [Y/n]: " confirm
      if [[ "${confirm,,}" == "n" || "${confirm,,}" == "no" ]]; then
        log "Automated install declined. Printing manual WinRM one-liner commands..."
        "$(venv_python)" -m guardapi.stap manual \
          --method winrm \
          --host "<DB_SERVER_IP>" \
          --guardium-ip "$col_ip"
        return 0
      fi
      ansible-playbook -i "$PROJECT_ROOT/ansible/inventory/hosts.yml" \
        "$PROJECT_ROOT/ansible/playbooks/install-stap-winrm.yml" \
        --extra-vars "guardium_collector_ip=$col_ip" || return 1
      state_set agents.stap true
      ;;

    3|gim)
      local gim_url="${GIM_SERVER_URL:-https://${col_ip}:8082}"
      local gim_user="${GIM_USERNAME:-admin}"
      local gim_pass="${GIM_PASSWORD:-}"
      if [[ -z "$gim_pass" && -t 0 ]]; then
        read -r -p "GIM server URL [$gim_url]: " in; [[ -n "$in" ]] && gim_url="$in"
        read -r -p "GIM username [$gim_user]: " in; [[ -n "$in" ]] && gim_user="$in"
        read -rs -p "GIM password: " gim_pass; echo
      fi
      echo ""
      read -r -p "Proceed with automated GIM S-TAP install? [Y/n]: " confirm
      if [[ "${confirm,,}" == "n" || "${confirm,,}" == "no" ]]; then
        log "Automated GIM install declined. Printing manual GIM one-liner commands..."
        "$(venv_python)" -m guardapi.stap manual \
          --method gim \
          --host "<DB_SERVER_IP>" \
          --guardium-ip "$col_ip" \
          --gim-url "$gim_url" \
          --gim-user "$gim_user"
        return 0
      fi
      ansible-playbook "$PROJECT_ROOT/ansible/playbooks/install-stap-gim.yml" \
        --extra-vars "gim_server_url=$gim_url" \
        --extra-vars "gim_username=$gim_user" \
        --extra-vars "gim_password=$gim_pass" \
        --extra-vars "guardium_collector_ip=$col_ip" \
        --extra-vars '{"db_hosts":[]}' || return 1
      state_set agents.gim true
      ;;

    4|manual)
      local sub_method
      read -r -p "Manual for which method? [ssh/winrm/gim]: " sub_method
      local db_host
      read -r -p "Target DB server IP/hostname: " db_host
      "$(venv_python)" -m guardapi.stap manual \
        --method "$sub_method" \
        --host "$db_host" \
        --guardium-ip "$col_ip"
      ;;

    *)
      error "Invalid selection '$method'"
      return 1
      ;;
  esac
}

# ── Validate / Status / Destroy ───────────────────────────────────────────────
validate() {
  validate_host || return 1
  require_command virsh || return 1
  virsh list --all
  log "Infrastructure validated. Appliance validation requires live Guardium access."
}

status() { cat "$STATE_FILE"; }

destroy() {
  [[ "${GUARDIUM_ALLOW_DESTROY:-}" == yes ]] || {
    error "Set GUARDIUM_ALLOW_DESTROY=yes before running destroy"; return 1
  }
  printf 'This destroys all Terraform-managed VMs. Type DESTROY to confirm: '
  read -r confirm
  [[ "$confirm" == DESTROY ]] || { log "Destroy cancelled"; return 0; }
  local iac; iac="$(command -v terraform || command -v tofu || true)"
  [[ -n "$iac" ]] || { error "Install Terraform or OpenTofu"; return 1; }
  sudo -n "$iac" -chdir="$PROJECT_ROOT/terraform" destroy -auto-approve
}

# ── Interactive menu ──────────────────────────────────────────────────────────
interactive_menu() {
  echo ""
  echo "╔══════════════════════════════════════════════════════════════════════╗"
  echo "║          IBM Guardium Deployment Automation — Full Lifecycle         ║"
  echo "╠══════════════════════════════════════════════════════════════════════╣"
  echo "║  INFRASTRUCTURE                                                      ║"
  echo "║   1. Deploy Collector                                                ║"
  echo "║   2. Deploy Aggregator                                               ║"
  echo "║   3. Deploy Both (full)                                              ║"
  echo "║   4. Converge Collector  (post-install network/config)               ║"
  echo "║   5. Converge Aggregator                                             ║"
  echo "╠══════════════════════════════════════════════════════════════════════╣"
  echo "║  INTEGRATION                                                         ║"
  echo "║   6. Register Collector → Aggregator                                 ║"
  echo "║   7. Deploy Sample Policies (Baseline, PCI-DSS, HIPAA, Extrusion)    ║"
  echo "╠══════════════════════════════════════════════════════════════════════╣"
  echo "║  S-TAP / GIM AGENT DEPLOYMENT                                       ║"
  echo "║   8. Install S-TAP (SSH / WinRM / GIM — prompts for method)          ║"
  echo "║   9. Print Manual One-liner Commands Only (no automation)            ║"
  echo "╠══════════════════════════════════════════════════════════════════════╣"
  echo "║  OPERATIONS                                                          ║"
  echo "║  10. Validate Infrastructure                                         ║"
  echo "║  11. Show Deployment State                                           ║"
  echo "║  12. Destroy Lab Environment                                         ║"
  echo "║  13. Exit                                                            ║"
  echo "╚══════════════════════════════════════════════════════════════════════╝"
  echo ""
  read -r -p "Select option: " opt
  case "$opt" in
    1)  provision collector    ;;
    2)  provision aggregator   ;;
    3)  provision full         ;;
    4)  converge collector     ;;
    5)  converge aggregator    ;;
    6)  register               ;;
    7)  policies               ;;
    8)  install_stap           ;;
    9)
      local sm db_ip col_ip; col_ip="$(config_value collector.ip)"
      read -r -p "Method [ssh/winrm/gim]: " sm
      read -r -p "Target DB host: " db_ip
      "$(venv_python)" -m guardapi.stap manual \
        --method "$sm" --host "$db_ip" --guardium-ip "$col_ip"
      ;;
    10) validate               ;;
    11) status                 ;;
    12) destroy                ;;
    13) return 0               ;;
    *)  error "Invalid selection" ;;
  esac
}

# ── Entry point ───────────────────────────────────────────────────────────────
case "${1:-menu}" in
  collector|aggregator|full)  provision "$1"      ;;
  converge)                   converge "${2:-}"   ;;
  register)                   register            ;;
  policies)                   policies            ;;
  stap|install-stap)          install_stap        ;;
  validate)                   validate            ;;
  status)                     status              ;;
  destroy)                    destroy             ;;
  menu)                       interactive_menu    ;;
  *)
    printf 'Usage: %s {collector|aggregator|full|converge <role>|register|policies|stap|validate|status|destroy|menu}\n' "$0" >&2
    exit 2
    ;;
esac
